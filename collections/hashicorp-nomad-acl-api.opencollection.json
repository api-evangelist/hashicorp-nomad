{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Nomad HTTP ACL API",
    "version": "1.8"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Nomad-Token",
      "value": "{{X-Nomad-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ACL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ACL tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/acl/tokens"
          },
          "docs": "List ACL tokens"
        },
        {
          "info": {
            "name": "List ACL policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/acl/policies"
          },
          "docs": "List ACL policies"
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Nomad HTTP ACL Evaluations API",
    "version": "1.8"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Nomad-Token",
      "value": "{{X-Nomad-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Evaluations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List evaluations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/evaluations"
          },
          "docs": "List evaluations"
        },
        {
          "info": {
            "name": "Read evaluation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/evaluation/:eval_id",
            "params": [
              {
                "name": "eval_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read evaluation"
        }
      ]
    }
  ],
  "bundled": true
}
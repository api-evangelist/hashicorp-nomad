{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Nomad HTTP ACL System API",
    "version": "1.8"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Nomad-Token",
      "value": "{{X-Nomad-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Read leader address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/status/leader"
          },
          "docs": "Read leader address"
        },
        {
          "info": {
            "name": "List server peers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/status/peers"
          },
          "docs": "List server peers"
        },
        {
          "info": {
            "name": "Agent health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://127.0.0.1:4646/v1/agent/health"
          },
          "docs": "Agent health"
        }
      ]
    }
  ],
  "bundled": true
}